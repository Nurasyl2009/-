# Local AI (no API key required)
AI_PROVIDER=ollama
AI_MODEL=qwen3.5:4b

# Optional OpenAI: set AI_PROVIDER=openai and select an available AI_MODEL
OPENAI_API_KEY=

# WhatsApp: fill locally, never commit .env
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ALLOWED_SENDERS=
WHATSAPP_API_VERSION=v23.0
